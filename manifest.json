{
  "manifest_version": 3,
  "name": "Bookmarks Utilities",
  "version": "1.2.0",
  "description": "Gestión superior de marcadores con búsqueda inteligente, agrupación por dominio y detección de enlaces muertos.",
  "permissions": [
    "bookmarks",
    "storage",
    "notifications",
    "downloads",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
